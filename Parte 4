//función para mostrar valores ADC de los 3 potenciómetros

void senalesUART(void){

	//no se muestra medicion a menos que se active la alarma
    detalleTemperatura[0] = '\0';
    detallePresion[0] = '\0';
    detallePulso[0] = '\0';

    // se muestran valores convertidos con sus unidades
    if (alarmaTemperaturaActiva){
        snprintf(detalleTemperatura, sizeof(detalleTemperatura), "Medicion: %u.%u °C\r\n", (unsigned int)(temperatura / 10U), (unsigned int)(temperatura % 10U));
    }

    if (alarmaPresionActiva){
        snprintf(detallePresion, sizeof(detallePresion), "Medicion: %u mmHg\r\n", (unsigned int)presion);
    }

    if (alarmaPulsoActiva){
        snprintf(detallePulso, sizeof(detallePulso), "Medicion: %u lpm\r\n", (unsigned int)pulso);
    }

    longitud = snprintf(mensaje, sizeof(mensaje),

        "\r\nTEMPERATURA CORPORAL\r\n"
        "Estado: %s\r\n"
        "%s"

        "\r\nPRESION SISTOLICA\r\n"
        "Estado: %s\r\n"
        "%s"

        "\r\nFRECUENCIA CARDIACA\r\n"
        "Estado: %s\r\n"
        "%s"

        "------------------------------\r\n",

        estadoTemperatura, detalleTemperatura,
        estadoPresion, detallePresion,
        estadoPulso, detallePulso
    );

    if (longitud > 0 && (size_t)longitud < sizeof(mensaje)){
        HAL_UART_Transmit(&huart2, (uint8_t *)mensaje, (uint16_t)longitud, 100);
    }
}

//función para mapear ADC de potenciómetros
static void calcularSenales(void)
{
    sensor1 = ADCValor[0];
    sensor2 = ADCValor[1];
    sensor3 = ADCValor[2];
    //mapeo de potenciómetros hasta 4095
    // mínimo + ADC*(máximo - mínimo) / 4095

    temperatura = 300U + ((uint32_t)sensor1 * 100U) / 4095U; //mínimo 30 y máximo 40 (multiplicada por 10)


    presion = 70U + ((uint32_t)sensor2 * 60U) / 4095U; //mínimo 70 y máximo 130


    pulso = 40U + ((uint32_t)sensor3 * 80U) / 4095U; //mínimo 40 y máximo 120
}


//función para evaluar límites de sensores y alarmas

static void evaluarAlarmas(void)
{
    //TEMPERATURA
    alarmaTemperaturaActiva = 0;

    if (temperatura < TEMP_MIN){
    	estadoTemperatura = "Temperatura baja";
        alarmaTemperaturaActiva = 1;
    }
    else if (temperatura > TEMP_MAX){
        estadoTemperatura = "Temperatura alta";
        alarmaTemperaturaActiva = 1;
    }
    else{
        estadoTemperatura = "Normal 36-37.5°C";
    }

    HAL_GPIO_WritePin(alarma1_GPIO_Port, alarma1_Pin, alarmaTemperaturaActiva ? GPIO_PIN_SET : GPIO_PIN_RESET);

    //PRESION SISTOLICA
    alarmaPresionActiva = 0;

    if (presion < PRE_MIN){
        estadoPresion = "Presion baja";
        alarmaPresionActiva = 1;
    }
    else if (presion > PRE_MAX){
        estadoPresion = "Presion elevada";
        alarmaPresionActiva = 1;
    }
    else{
        estadoPresion = "Normal 90-119mmHg";
    }

    HAL_GPIO_WritePin(alarma2_GPIO_Port, alarma2_Pin, alarmaPresionActiva ? GPIO_PIN_SET : GPIO_PIN_RESET);

    //FRECUENCIA CARDIACA
    alarmaPulsoActiva = 0;

    if (pulso < PUL_MIN){
        estadoPulso = "Bradicardia";
        alarmaPulsoActiva = 1;
    }
    else if (pulso > PUL_MAX){
        estadoPulso = "Taquicardia";
        alarmaPulsoActiva = 1;
    }
    else{
        estadoPulso = "Normal 60-100lpm";
    }

    HAL_GPIO_WritePin(alarma3_GPIO_Port, alarma3_Pin, alarmaPulsoActiva ? GPIO_PIN_SET : GPIO_PIN_RESET);
}


